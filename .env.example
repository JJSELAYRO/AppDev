# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.render.com,.onrender.com

# Database (PostgreSQL on Render)
# Leave empty for SQLite (development)
# DATABASE_URL=postgres://user:password@host:port/database

# Twilio SMS Settings (Trial Mode)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# School GPS Coordinates (Default: Manila)
SCHOOL_LATITUDE=14.5995
SCHOOL_LONGITUDE=120.9842
GPS_RADIUS_METERS=100
